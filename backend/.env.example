PORT=4000
NODE_ENV=production
# Public URL of this API (used to build signed audio stream links)
PUBLIC_URL=https://api.your-domain.com
# Frontend origins allowed by CORS, comma separated
CORS_ORIGIN=https://your-domain.com
# At least 32 random characters: openssl rand -hex 32
TOKEN_SECRET=
DATA_DIR=./data
MAX_UPLOAD_MB=50

# SMTP for verification and reset emails (Gmail app password, Brevo, Resend SMTP, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nightshade <no-reply@your-domain.com>

# Only for demos without SMTP: returns codes in API responses. Never enable in production.
EXPOSE_DEV_CODES=false
